import os
import threading
import torch
from transformers import AutoTokenizer, AutoModelForCausalLM

class LocalQwen:
    def __init__(self, model_id: str = None):
	self.model_id = os.environ.get("QWEN_MODEL_ID", "Qwen/Qwen2.5-0.5B-Instruct")
        self._lock = threading.Lock()
        self._ready = False
        self.tokenizer = None
        self.model = None

    def _lazy_load(self):
        if self._ready:
            return
        with self._lock:
            if self._ready:
                return

            self.tokenizer = AutoTokenizer.from_pretrained(self.model_id, use_fast=True, local_files_only=True,)
            dtype = torch.float16 if torch.cuda.is_available() else torch.float32

            self.model = AutoModelForCausalLM.from_pretrained(
                self.model_id,
                torch_dtype=dtype,
                device_map="auto",
		local_files_only=True,
            )
            self._ready = True

    def chat(self, user_text: str, system_prompt: str = "你是一个简洁、有帮助的助手。", max_new_tokens: int = 256):
        self._lazy_load()

        messages = [
            {"role": "system", "content": system_prompt},
            {"role": "user", "content": user_text},
        ]

        prompt = self.tokenizer.apply_chat_template(
            messages,
            tokenize=False,
            add_generation_prompt=True,
        )

        inputs = self.tokenizer(prompt, return_tensors="pt").to(self.model.device)

        with torch.no_grad():
            output = self.model.generate(
                **inputs,
                max_new_tokens=max_new_tokens,
                do_sample=True,
                temperature=0.7,
                top_p=0.9,
                repetition_penalty=1.05,
            )

        text = self.tokenizer.decode(output[0], skip_special_tokens=True)

        # 简易抽取：取 user_text 之后的内容作为回复（够用版）
        if user_text in text:
            text = text.split(user_text, 1)[-1].strip()
        return text.strip()

qwen = LocalQwen()
